# Perfil de Spring (dev o prod)
SPRING_PROFILE=prod

# Configuración de Base de Datos (requerido en producción)
DB_URL=jdbc:postgresql://localhost:5432/red_comunitaria
DB_USERNAME=postgres
DB_PASSWORD=tu_password_aqui

# Configuración JWT (requerido siempre)
JWT_SECRET=genera_un_secret_base64_seguro_aqui
JWT_EXPIRATION=86400000

# Puerto del servidor (opcional, por defecto 8080)
SERVER_PORT=8080

# Notas:
# - En DESARROLLO: no necesitas este archivo, usa el perfil 'dev' por defecto
# - En PRODUCCIÓN: configura estas variables de entorno obligatoriamente
# - NUNCA subas credenciales reales al repositorio
# - Para generar JWT_SECRET seguro: openssl rand -base64 64
